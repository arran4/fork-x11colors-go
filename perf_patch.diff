				// Luma = 0.2126 * R + 0.7152 * G + 0.0722 * B
				luma := 0.2126*float64(r) + 0.7152*float64(g) + 0.0722*float64(b)
				captionBlack := luma > 128

				return X11Color{
					Name:         Name(s),
					RGBA:         color.RGBA{R: r, G: g, B: b, A: 0xFF},
					CaptionBlack: captionBlack,
				}, true
			}
		}
	}

